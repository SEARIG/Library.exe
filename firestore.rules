rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function user() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return user().data;
    }

    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (profile().status in ["active", "trialing"] || profile().active == true);
    }

    function role() {
      return active() ? profile().role : "";
    }

    function superAdmin() {
      return role() == "super_admin";
    }

    function adminRole() {
      return role() in ["super_admin", "university_admin", "college_admin", "library_admin"];
    }

    function staffRole() {
      return role() in ["super_admin", "university_admin", "college_admin", "library_admin", "librarian"];
    }

    function isAdmin() {
      return superAdmin() || adminRole() || role() == "admin";
    }

    function isLibrarian() {
      return staffRole() || role() == "admin";
    }

    function isStaff() {
      return staffRole() || role() == "admin";
    }

    function sameTenant(data) {
      return superAdmin()
        || (
          active()
          && data.orgType == profile().orgType
          && (!("universityId" in data) || data.universityId == null || data.universityId == profile().universityId)
          && (!("collegeId" in data) || data.collegeId == null || data.collegeId == profile().collegeId)
          && (!("libraryId" in data) || data.libraryId == null || data.libraryId == profile().libraryId)
        );
    }

    function ownStudentRecord(data) {
      return active()
        && role() == "student"
        && data.studentUid == request.auth.uid;
    }

    function validStudentIssueRequestCreate(requestId) {
      let data = request.resource.data;
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == "student"
        && profile().active == true
        && data.keys().hasAll([
          "type",
          "requestId",
          "studentUid",
          "bookId",
          "status",
          "confirmationChecked",
          "source",
          "requestedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "type",
          "requestId",
          "studentUid",
          "studentName",
          "studentEmail",
          "studentPhone",
          "studentBranch",
          "rollNo",
          "rollNumber",
          "enrollmentNumber",
          "bookId",
          "b_id",
          "accessionNumber",
          "author",
          "title",
          "bookTitle",
          "placePublisher",
          "year",
          "pages",
          "volume",
          "imageUrl",
          "bookImage",
          "barcodeValue",
          "bookBarcodeValue",
          "subject",
          "category",
          "preferredSlot",
          "status",
          "confirmationChecked",
          "source",
          "requestedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.requestId == requestId
        && data.studentUid == request.auth.uid
        && data.type == "issue"
        && data.status == "pending"
        && data.source == "android_student_app"
        && data.confirmationChecked == true
        && data.bookId is string
        && data.bookId.size() > 0
        && exists(/databases/$(database)/documents/books/$(data.bookId))
        && get(/databases/$(database)/documents/books/$(data.bookId)).data.status == "available"
        && data.requestedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function protectedFieldsClean() {
      return request.resource.data.keys().hasAll(["orgType", "createdAt", "updatedAt", "status"]);
    }

    function bookMetadataPublicOnly() {
      return !request.resource.data.keys().hasAny([
        "accessionNumber",
        "blegal_num",
        "blegalNumber",
        "BLegalNumber",
        "accessionDate",
        "acquisitionSource",
        "billNoDate",
        "cost",
        "classNo",
        "bookNo",
        "withdrawalRemarks",
        "notes",
        "barcodeValue",
        "bookBarcodeValue",
        "barcodeDataUrl",
        "barcodePrinted",
        "barcodePrintedAt",
        "barcodePrintedBy",
        "barcodePrintBatchId",
        "issuedStudentUid",
        "issuedTo",
        "issuedToName",
        "issuedToEmail",
        "currentIssueId",
        "status",
        "b_id",
        "bookId",
        "importBatchId"
      ]);
    }

    function validIndianMobile(value) {
      return value is string && value.matches('^\\+91[6-9][0-9]{9}$');
    }

    function studentAccountCreate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          "uid", "fullName", "branch", "email", "phone", "role", "active", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "fullName", "name", "branch", "department", "email", "phone", "role", "active", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == "student"
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.branch is string
        && request.resource.data.branch.size() > 0
        && validIndianMobile(request.resource.data.phone);
    }

    function studentProfileCreate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          "uid", "fullName", "branch", "email", "phone", "role", "active", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "fullName", "name", "branch", "department", "email", "phone", "role", "active", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == "student"
        && request.resource.data.active == true
        && validIndianMobile(request.resource.data.phone)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == "student";
    }

    function adminStaffCreate(uid) {
      return isAdmin()
        && request.auth.uid != uid
        && request.resource.data.keys().hasAll([
          "uid", "fullName", "email", "phone", "role", "active", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "fullName", "name", "email", "phone", "role", "active", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role in ["admin", "librarian"]
        && request.resource.data.active == true
        && validIndianMobile(request.resource.data.phone);
    }

    function ownUserProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "uid", "firebaseAuthUid", "role", "active", "status", "permissions", "claims",
        "orgType", "universityId", "collegeId", "libraryId", "createdAt"
      ]);
    }

    function adminUserUpdate(uid) {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fullName", "name", "email", "phone", "branch", "department", "role", "active", "updatedAt"
        ])
        && request.resource.data.role in ["student", "librarian", "admin"]
        && (
          request.auth.uid != uid
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "active"])
        );
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (superAdmin() || role() == "admin" || request.auth.uid == uid || (staffRole() && sameTenant(resource.data)));
      allow create: if studentAccountCreate(uid) || adminStaffCreate(uid);
      allow update: if superAdmin()
        || adminUserUpdate(uid)
        || (signedIn() && request.auth.uid == uid && ownUserProtectedFieldsUnchanged());
      allow delete: if superAdmin() || role() == "admin";
    }

    match /students/{uid} {
      allow read: if active() && (request.auth.uid == uid || staffRole() || role() == "admin");
      allow create: if studentProfileCreate(uid)
        || (active() && (staffRole() || role() == "admin"));
      allow update: if active()
        && (
          staffRole()
          || role() == "admin"
          || (
            request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "uid", "role", "active", "status", "permissions", "claims", "createdAt"
            ])
          )
        );
      allow delete: if superAdmin() || role() == "admin";
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update: if active()
        && isLibrarian()
        && request.resource.data.status in ["available", "issued", "lost", "damaged"];
      allow delete: if isAdmin();
    }

    match /bookMetadata/{metadataId} {
      allow read: if signedIn() && isStaff();
      allow create, update: if signedIn() && isStaff() && bookMetadataPublicOnly();
      allow delete: if signedIn() && isAdmin();
    }

    match /barcodePrintBatches/{batchId} {
      allow read, create, update: if active() && (staffRole() || role() == "admin");
      allow delete: if superAdmin() || role() == "admin";
    }

    match /barcodePrintLogs/{logId} {
      allow read, create: if active() && (staffRole() || role() == "admin");
      allow update, delete: if superAdmin() || role() == "admin";
    }

    match /librarySettings/{settingId} {
      allow read: if true;
      allow create, update: if active() && (staffRole() || role() == "admin");
      allow delete: if superAdmin() || role() == "admin";
    }

    match /bookIssues/{issueId} {
      allow read: if active()
        && (resource.data.studentUid == request.auth.uid || staffRole() || role() == "admin");
      allow create, update: if active() && (staffRole() || role() == "admin");
      allow delete: if superAdmin() || role() == "admin";
    }

    match /penalties/{penaltyId} {
      allow read: if signedIn()
        && (resource.data.studentUid == request.auth.uid || isLibrarian());
      allow create, update: if isLibrarian();
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update: if active() && (staffRole() || role() == "admin");
      allow delete: if superAdmin() || role() == "admin";
    }

    match /universities/{universityId} {
      allow read: if superAdmin() || (active() && profile().universityId == universityId);
      allow create, update, delete: if superAdmin();

      match /colleges/{collegeId} {
        allow read: if superAdmin()
          || (active() && profile().universityId == universityId && (role() == "university_admin" || profile().collegeId == collegeId));
        allow create, update: if superAdmin() || (role() == "university_admin" && profile().universityId == universityId);
        allow delete: if superAdmin();

        match /books/{bookId} {
          allow read: if active() && sameTenant(resource.data);
          allow create, update: if staffRole() && sameTenant(request.resource.data) && protectedFieldsClean();
          allow delete: if adminRole() && sameTenant(resource.data);
        }

        match /students/{studentUid} {
          allow read: if (request.auth.uid == studentUid) || (active() && sameTenant(resource.data));
          allow create, update: if staffRole() && sameTenant(request.resource.data) && protectedFieldsClean();
          allow delete: if adminRole() && sameTenant(resource.data);
        }

        match /staff/{staffId} {
          allow read: if staffRole() && sameTenant(resource.data);
          allow create, update: if adminRole() && sameTenant(request.resource.data);
          allow delete: if adminRole() && sameTenant(resource.data);
        }
      }
    }

    match /independentColleges/{collegeId} {
      allow read: if superAdmin() || (active() && profile().collegeId == collegeId);
      allow create, update, delete: if superAdmin();

      match /books/{bookId} {
        allow read: if active() && sameTenant(resource.data);
        allow create, update: if staffRole() && sameTenant(request.resource.data) && protectedFieldsClean();
        allow delete: if adminRole() && sameTenant(resource.data);
      }

      match /students/{studentUid} {
        allow read: if (request.auth.uid == studentUid) || (active() && sameTenant(resource.data));
        allow create, update: if staffRole() && sameTenant(request.resource.data) && protectedFieldsClean();
        allow delete: if adminRole() && sameTenant(resource.data);
      }

      match /staff/{staffId} {
        allow read: if staffRole() && sameTenant(resource.data);
        allow create, update: if adminRole() && sameTenant(request.resource.data);
        allow delete: if adminRole() && sameTenant(resource.data);
      }
    }

    match /privateLibraries/{libraryId} {
      allow read: if superAdmin() || (active() && profile().libraryId == libraryId);
      allow create, update, delete: if superAdmin();

      match /books/{bookId} {
        allow read: if active() && sameTenant(resource.data);
        allow create, update: if staffRole() && sameTenant(request.resource.data) && protectedFieldsClean();
        allow delete: if adminRole() && sameTenant(resource.data);
      }

      match /members/{studentUid} {
        allow read: if (request.auth.uid == studentUid) || (active() && sameTenant(resource.data));
        allow create, update: if staffRole() && sameTenant(request.resource.data) && protectedFieldsClean();
        allow delete: if adminRole() && sameTenant(resource.data);
      }

      match /staff/{staffId} {
        allow read: if staffRole() && sameTenant(resource.data);
        allow create, update: if adminRole() && sameTenant(request.resource.data);
        allow delete: if adminRole() && sameTenant(resource.data);
      }
    }

    match /issueRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.studentUid == request.auth.uid || isLibrarian());

      // Spark-compatible request creation: students can only submit their own
      // strictly-shaped pending request for an existing available book.
      allow create: if validStudentIssueRequestCreate(requestId);

      // Review, pickup approval, rejection and issuance remain staff-only.
      allow update: if isLibrarian();

      allow delete: if isAdmin();
    }

    match /returnRequests/{requestId} {
      allow read: if active()
        && (
          resource.data.studentUid == request.auth.uid
          || staffRole()
          || role() == "admin"
        );
      allow create: if active()
        && role() == "student"
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.confirmationChecked == true;
      allow update: if active() && (staffRole() || role() == "admin");
      allow delete: if superAdmin() || role() == "admin";
    }

    match /issueRecords/{issueId} {
      allow read: if active() && (sameTenant(resource.data) || ownStudentRecord(resource.data));
      allow create, update: if staffRole() && sameTenant(request.resource.data);
      allow delete: if superAdmin();
    }

    match /returnRecords/{returnId} {
      allow read: if active() && (sameTenant(resource.data) || ownStudentRecord(resource.data));
      allow create, update: if staffRole() && sameTenant(request.resource.data);
      allow delete: if superAdmin();
    }

    match /lostBookRecords/{lostRecordId} {
      allow read: if staffRole() && sameTenant(resource.data);
      allow create, update: if staffRole() && sameTenant(request.resource.data);
      allow delete: if superAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if superAdmin() || (adminRole() && sameTenant(resource.data));
      allow write: if superAdmin();
    }

    match /payments/{paymentId} {
      allow read: if superAdmin() || (adminRole() && sameTenant(resource.data));
      allow write: if superAdmin();
    }

    match /emailLogs/{emailId} {
      allow read: if superAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if superAdmin() || (staffRole() && sameTenant(resource.data));
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
